module addsub(a,b,control,c);

input [3:0] a,b;
input control;
output reg [3:0] c;

always @ *
begin

if (control == 0)
c = a + b;
else if (control == 1)
c = a - b;
end

endmodule

module testbench();

reg [3:0] a,b;
reg control;
wire [3:0] c;

addsub uut(a,b,control,c);

